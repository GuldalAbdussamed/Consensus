# Engelsiz TV Backend Configuration
# Hiçbiri zorunlu değil: varsayılanlar sıfır maliyetli yerel kurulumdur
# (Ollama + Piper). Sadece değiştirmek istediklerini aç.

# ── VLM: OpenAI-uyumlu herhangi bir endpoint ─────────────
# Yerel Ollama (varsayılan). Kurulum: `ollama pull gemma3:4b`
# VLLM_URL=http://localhost:11434/v1
# VLLM_MODEL=gemma3:4b

# GPU sunucusunda vLLM (eski kurulum)
# VLLM_URL=http://your-vllm-url:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
# VLLM_API_KEY=your_vllm_api_key
# VLM_MAX_CONCURRENCY=5
# VLM_TIMEOUT_SEC=5

# Not: "thinking" modelleri (qwen3-vl, gemini-2.5-flash vb.) kısa max_tokens
# bütçesini düşünmeye harcayıp boş cevap döner — düşünmesi kapalı model seç.

# ── TTS: piper (yerel, varsayılan) | xtts | mock ─────────
# TTS_BACKEND=piper
# TTS_VOICE=tr_TR-dfki-medium

# XTTS-v2 sunucusu (GPU)
# TTS_BACKEND=xtts
# TTS_URL=http://your-tts-url:8020
# WORDS_PER_SECOND=3.0

# ── Logging ──────────────────────────────────────────────
# LOG_LEVEL=INFO
